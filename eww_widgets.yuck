(include "eww_vars.yuck")

(defwidget test []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (button
      :class "button"
      :onclick "bash /home/thomasr/.config/eww/scripts/dice.sh"
      (label :class "icon-label" :text {dice-button-text})
    )
  )
)

(defwidget audio-visualizer []
  (box :height "100" :width "220" :halign "center" :valign "center" :class "container"
    (button
      :class "button"
      :onclick "bash /home/thomasr/.config/eww/scripts/toggle_visualizer.sh"
      (label
        :class "ascii-visualizer"
        :text {cava-ascii-string} ; Binds to the polled variable
      )
    )
  )
)

(defwidget oblique-strategies []
  (box :height "100" :width "340" :halign "center" :valign "center" :class "container"
    (label
      :class "label"
      :wrap true
      :show-truncated false
      :wrap-mode "word"
      :justify "center"
      :text STRATEGY
    )
  )
)


(defwidget daybox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text DAY)
  )
)

(defwidget monthbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text MONTH)
  )
)

(defwidget yearbox []
  (box :height "100" :width "100" :halign "center" :valign "center" :class "container"
    (label :class "label"  :text YEAR)
  )
)

(defwidget userinfobox []
  (centerbox :height "100" :width "340" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "cd /home/thomasr && kitty -e bash -c 'hyfetch; exec bash' & disown" :class "button"
        (label :class "icon-label"  :text "⌘")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "GTK_THEME=diinki-retro-dark nautilus & disown"  :class "button"
        (label :class "icon-label"  :text "🗀")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww open powermenu" :class "button"
        (label :class "icon-label"  :text "⭘")
      )
    )
  )
)

(defwidget powermenu []
  (centerbox :height "100" :width "340" :halign "center" :valign "center" :class "userinfo-parent"
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl poweroff" :class "poweroff-button"
        (label :class "icon-label"  :text "⏻")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "systemctl suspend"  :class "suspend-button"
        (label :class "icon-label"  :text "⏾")
      )
    )
    (box :height "100" :width "113" :halign "center" :valign "center" :class "userinfo-child"
      (button :onclick "eww close powermenu" :class "button"
        (label :class "icon-label"  :text "⨯")
      )
    )
  )
)