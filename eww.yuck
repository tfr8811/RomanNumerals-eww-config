(include "eww_widgets.yuck")

(defwindow taskbar
  :monitor '[0]'
  :stacking "fg"
  :geometry (geometry
    :x "0"
    :y "10"
    :width "920"
    :height "40"
    :anchor "top center")
  (taskbar) ; opens the widget
)

(defwindow test
  :monitor '[0]'
  :stacking "fg"
  :geometry (geometry
    :x "50"
    :y "50"
    :width "300"
    :height "100"
    :anchor "bottom right")
  (test) ; opens the widget
)

(defwindow facts
  :monitor '[0]'
  :stacking "fg"
  :geometry (geometry
    :x "50"
    :y "50"
    :width "400"
    :height "200"
    :anchor "bottom left")
  (facts) ; opens the widget
)